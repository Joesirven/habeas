# Copy to .env for local development. Never commit real values.

# Temp dev Cloud SQL (dpra-dev-temp)
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@INSTANCE_IP:5432/postgres?sslmode=require

# ADMIN_API_URL=http://127.0.0.1:8000
# Remote admin-api (*.run.app) requires IAP — set one of:
# IAP_OAUTH_CLIENT_ID=   # google-auth / gcloud print-identity-token --audiences=...
# IAP_ID_TOKEN=          # prefetched bearer (optional)
# REQUIRE_IAP_IDENTITY=false   # local only; deployed admin-api-dev forces true

# CA DROP Sandbox (MVP). Never use production host while DROP_ENV=sandbox.
# Portal: https://databroker.drop.privacy.ca.gov/sandbox
# List types for this key: NDZ + Email + Phone
# Auth header: X-API-KEY. Connector refuses URL without /sandbox when DROP_ENV=sandbox.
DROP_ENV=sandbox
DROP_API_BASE_URL=https://api.drop.privacy.ca.gov/sandbox
DROP_API_KEY=

# Admin-api DROP pipeline proxies (ops console /ops/drop-pipeline). Optional overrides.
# DROP_CONNECTOR_URL=http://127.0.0.1:8081
# DROP_INGESTOR_URL=http://127.0.0.1:8082
# REQUEST_DISPATCHER_URL=http://127.0.0.1:8083
# MATCHING_URL=http://127.0.0.1:8084
# DATA_FULFILLMENT_URL=http://127.0.0.1:8085
# HASH_INDEX_REFRESH_URL=http://127.0.0.1:8086

# DROP hash index BQ lookup (matching worker)
# DROP_HASH_LOOKUP_STATE=CA
