# Leave unset / localhost for local Vite → local admin-api.
# Do NOT set VITE_ADMIN_API_URL when using the proxy (browser must call /api).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# --- Local web → deployed admin-api-dev (ADC, super_admin only) ---
# Mint/caches a Google ID token via Application Default Credentials
# (audience = origin of VITE_PROXY_TARGET). Actor email comes from the verified JWT
# — IAP_USER_EMAIL is not required for this path.
#
#   gcloud auth application-default login
#   # principal must be listed in SUPER_ADMINS on admin-api-dev
#
# VITE_PROXY_TARGET=https://admin-api-dev-hsa55rg7ja-uk.a.run.app
#
# Non-super_admin operators: use the ops-ia IAP front door instead of ADC proxy:
#   https://ops-ia-web-dev-hsa55rg7ja-uk.a.run.app
#
# Optional overrides (legacy / debugging):
# IAP_ID_TOKEN=          # or CLOUD_RUN_ID_TOKEN — skip ADC mint; static Bearer
# IAP_USER_EMAIL=        # still forwarded as X-Goog-Authenticated-User-Email if set
