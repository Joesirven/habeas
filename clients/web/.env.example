# Leave unset in local dev to use Vite proxy (/api → localhost:8000).
# Do NOT set VITE_ADMIN_API_URL when using the proxy (browser must call /api).

# Local UI → deployed admin-api (ops-ia nginx pattern):
#   Authorization = Cloud Run invoker ID token (audience = admin-api URL)
#   X-Goog-Authenticated-User-Email = allowlisted operator email
# VITE_PROXY_TARGET=https://admin-api-dev-hsa55rg7ja-uk.a.run.app
# IAP_USER_EMAIL=dev-owner-1@example.com
# IAP_ID_TOKEN=   # gcloud auth print-identity-token --audiences="$VITE_PROXY_TARGET" \
#                 #   --impersonate-service-account=95660886550-compute@developer.gserviceaccount.com \
#                 #   --include-email
