# Leave unset / localhost for local Vite → local admin-api.
# Do NOT set VITE_ADMIN_API_URL when using the proxy (browser must call /api).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# --- Local web → deployed admin-api-dev (Application Default Credentials) ---
# Mint a Cloud Run ID token from your user ADC (same audience as habeas-cli auth login --adc).
#
#   gcloud auth application-default login
#
# VITE_PROXY_TARGET=https://admin-api-dev-hsa55rg7ja-uk.a.run.app
#
# IAP_USER_EMAIL is optional for ADC: admin-api reads your email from the JWT when it
# matches ADMIN_API_SUPER_ADMINS. Set it only for SA impersonation fallback.
# IAP_USER_EMAIL=you@example.com
# IAP_IMPERSONATE_SERVICE_ACCOUNT=95660886550-compute@developer.gserviceaccount.com
#
# Non-super_admin operators: use the ops-ia IAP front door instead:
#   https://ops-ia-web-dev-hsa55rg7ja-uk.a.run.app
#
# Optional override (must be a Cloud Run ID token for VITE_PROXY_TARGET origin):
# CLOUD_RUN_ID_TOKEN=
# Do NOT paste an IAP_OAUTH_CLIENT_ID audience token into IAP_ID_TOKEN — it will 401.
